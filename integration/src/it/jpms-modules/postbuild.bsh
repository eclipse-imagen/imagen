import java.io.*;

File buildLog = new File( basedir, "build.log" );
if (!buildLog.isFile()) {
    throw new FileNotFoundException( "Could locate build.log: " + buildLog );
}
String log = org.apache.commons.io.FileUtils.readFileToString(buildLog);

String[] expected = new String[] {
    "JPMS jpms-modules: module org.eclipse.imagen.it.modules",
    "JPMS jpms-modules: imagen module org.eclipse.imagen.core",
    "JPMS jpms-modules: Scale2 width 32",
    "JPMS jpms-modules: Jiffle sample 17.0",
    "JPMS jpms-modules: Jiffle var 42.0",
    "JPMS jpms-modules: Jiffle runtime sample 42",
    "JPMS jpms-modules: all checks passed"
};
for (String line : expected) {
    if (!log.contains(line)) {
        throw new IllegalStateException("Expected: " + line);
    }
}
